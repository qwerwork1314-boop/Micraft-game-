    "Apple Watch didn't respond. Make sure it's on your wrist, unlocked and nearby, and that the VitalFlow watch app is installed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch didn't respond. Make sure it's on your wrist, unlocked and nearby, and that the VitalFlow watch app is installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 没有响应。请确认手表戴在手腕上、已解锁、在附近，并已安装 VitalFlow 手表 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 沒有回應。請確認手錶戴在手腕上、已解鎖、在附近，並已安裝 VitalFlow 手錶 App。"
          }
