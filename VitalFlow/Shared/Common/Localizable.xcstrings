    "Scores need about 4 nights of sleep with Apple Watch to learn your baseline. Until then they show “Not enough data”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores need about 4 nights of sleep with Apple Watch to learn your baseline. Until then they show “Not enough data”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评分需要约 4 晚佩戴 Apple Watch 睡眠的数据来学习你的基线，在此之前会显示“数据不足”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
