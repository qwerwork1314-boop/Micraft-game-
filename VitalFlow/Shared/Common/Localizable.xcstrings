    "Settings, cached daily scores and assistant conversations are stored on this device with iOS file protection. Widgets receive only summary scores.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings, cached daily scores and assistant conversations are stored on this device with iOS file protection. Widgets receive only summary scores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置、缓存的每日评分和助手对话以 iOS 文件保护方式存储在本设备上。小组件只获取摘要评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、快取的每日評分和助手對話以 iOS 檔案保護方式儲存在本裝置上。小工具只獲取摘要評分。"
          }
        }
      }
    },
    "Several wake-ups last night. A cool, dark, quiet room and less caffeine late in the day may help.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several wake-ups last night. A cool, dark, quiet room and less caffeine late in the day may help."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚醒来多次。凉爽、黑暗、安静的房间以及下午后减少咖啡因可能会有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚醒來多次。涼爽、黑暗、安靜的房間以及下午後減少咖啡因可能會有幫助。"
          }
        }
      }
    },
    "Shows clearly labelled synthetic data for exploring the app. Demo data is never written to Health and is never mixed with your real data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows clearly labelled synthetic data for exploring the app. Demo data is never written to Health and is never mixed with your real data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示带有明确标识的合成数据以便体验 App。演示数据绝不会写入“健康”，也不会与你的真实数据混合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示帶有明確標示的合成資料以便體驗 App。示範資料絕不會寫入「健康」，也不會與你的真實資料混合。"
          }
        }
      }
    },
