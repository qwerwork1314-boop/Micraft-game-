    "Answers are generated privately on your iPhone from your own data. Nothing is sent to the internet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers are generated privately on your iPhone from your own data. Nothing is sent to the internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答由你的 iPhone 根据你自己的数据私密生成，不会发送到互联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答由你的 iPhone 根據你自己的資料私密產生，不會傳送到網際網路。"
          }
        }
      }
    },
