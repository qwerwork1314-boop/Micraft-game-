    "You can turn this off at any time; the key is deleted immediately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn this off at any time; the key is deleted immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时关闭此功能，密钥会被立即删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時關閉此功能，金鑰會被立即刪除。"
          }
        }
      }
    },
    "You look well recovered. A good day for the workout you enjoy most.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You look well recovered. A good day for the workout you enjoy most."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你看起来恢复得不错，今天很适合做你最喜欢的运动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你看起來恢復得不錯，今天很適合做你最喜歡的運動。"
          }
        }
      }
    },
    "You slept less than your goal. Going to bed 20–30 minutes earlier is a gentle way to catch up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You slept less than your goal. Going to bed 20–30 minutes earlier is a gentle way to catch up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的睡眠少于目标。提早 20–30 分钟上床是一种温和的补觉方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的睡眠少於目標。提早 20–30 分鐘上床是一種溫和的補覺方式。"
          }
        }
      }
    },
    "You use your own API key, stored only in this device's Keychain. The provider's own privacy terms apply to data it receives.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You use your own API key, stored only in this device's Keychain. The provider's own privacy terms apply to data it receives."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你使用自己的 API 密钥，它只存储在本设备的钥匙串中。服务提供商收到的数据适用其自身的隐私条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你使用自己的 API 金鑰，它只儲存在本裝置的鑰匙圈中。服務提供商收到的資料適用其自身的隱私條款。"
          }
        }
      }
    },
    "Your body may appreciate an easier day: gentle movement, good food and an early night.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body may appreciate an easier day: gentle movement, good food and an early night."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的身体可能需要轻松一点的一天：温和活动、好好吃饭、早点休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的身體可能需要輕鬆一點的一天：溫和活動、好好吃飯、早點休息。"
          }
        }
      }
    },
