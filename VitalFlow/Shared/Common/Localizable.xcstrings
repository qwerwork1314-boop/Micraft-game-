          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以基于恢复和睡眠的晨间电量为起点，随清醒时间、活动和较高压力而消耗，并在平静时段少量回充。"
          }
        },
        "zh-Hant": {
