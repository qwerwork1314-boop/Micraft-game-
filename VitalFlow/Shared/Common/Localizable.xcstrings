          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结合恢复分数（65%）与最近 7 天训练负荷相对最近 28 天的比值（35%）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
