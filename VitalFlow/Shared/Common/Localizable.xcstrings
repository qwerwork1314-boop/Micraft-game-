          }
        }
      }
    },
    "Compares last night's HRV and resting heart rate with your own 28-day baseline, combined with sleep quality and, when available, respiratory rate and wrist temperature. Needs at least 4 days of history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares last night's HRV and resting heart rate with your own 28-day baseline, combined with sleep quality and, when available, respiratory rate and wrist temperature. Needs at least 4 days of history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将昨晚的 HRV 和静息心率与你自己的 28 天基线比较，并结合睡眠质量，以及可用时的呼吸频率和手腕温度。需要至少 4 天的历史数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將昨晚的 HRV 和靜息心率與你自己的 28 天基線比較，並結合睡眠品質，以及可用時的呼吸頻率和手腕溫度。需要至少 4 天的歷史資料。"
          }
        }
      }
    },
