    "Your question and a small summary of your scores are sent to Anthropic (Claude) over an encrypted connection to generate an answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your question and a small summary of your scores are sent to Anthropic (Claude) over an encrypted connection to generate an answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的问题和一份简短的评分摘要会通过加密连接发送给 Anthropic（Claude）以生成回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的問題和一份簡短的評分摘要會透過加密連線傳送給 Anthropic（Claude）以生成回答。"
          }
        }
      }
    },
    "Your sleep timing varied this week. Similar bed and wake times help your body clock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sleep timing varied this week. Similar bed and wake times help your body clock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周你的作息时间变化较大。相近的入睡和起床时间有助于生物钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週你的作息時間變化較大。相近的入睡和起床時間有助於生物鐘。"
          }
        }
      }
    },
    "Your usual bedtime is coming up. Dim the lights and let the day settle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your usual bedtime is coming up. Dim the lights and let the day settle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快到你平时的就寝时间了。调暗灯光，让这一天慢慢沉静下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快到你平時的就寢時間了。調暗燈光，讓這一天慢慢沉靜下來。"
          }
        }
      }
    },
