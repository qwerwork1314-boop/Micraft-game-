    "Low with fewer than 14 days of baseline or missing inputs, medium with 14–20 days, high with 21+ days and most inputs available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low with fewer than 14 days of baseline or missing inputs, medium with 14–20 days, high with 21+ days and most inputs available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基线不足 14 天或输入缺失时为低，14–20 天为中，21 天以上且大部分输入可用时为高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基線不足 14 天或輸入缺失時為低，14–20 天為中，21 天以上且大部分輸入可用時為高。"
          }
        }
      }
