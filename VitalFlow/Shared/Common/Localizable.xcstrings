    "The AI coach uses Apple Intelligence on your iPhone: free, private, nothing leaves the device. The external assistant is optional, off by default, and used only when Apple Intelligence isn't available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI coach uses Apple Intelligence on your iPhone: free, private, nothing leaves the device. The external assistant is optional, off by default, and used only when Apple Intelligence isn't available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 教练使用你 iPhone 上的 Apple 智能：免费、私密，数据不会离开设备。外部助手为可选功能，默认关闭，仅在 Apple 智能不可用时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 教練使用你 iPhone 上的 Apple Intelligence：免費、私密，資料不會離開裝置。外部助手為選用功能，預設關閉，僅在 Apple Intelligence 無法使用時使用。"
          }
        }
      }
    },
