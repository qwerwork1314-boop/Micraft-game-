    "Only rounded daily numbers are sent — for example recovery, sleep hours, resting heart rate and HRV averages. No raw samples, names, dates of birth, device identifiers or locations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only rounded daily numbers are sent — for example recovery, sleep hours, resting heart rate and HRV averages. No raw samples, names, dates of birth, device identifiers or locations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送四舍五入后的每日数值——例如恢复分数、睡眠时长、静息心率和 HRV 平均值。不发送原始样本、姓名、出生日期、设备标识或位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅傳送四捨五入後的每日數值——例如恢復分數、睡眠時長、靜息心率和 HRV 平均值。不傳送原始樣本、姓名、出生日期、裝置標示或位置。"
          }
        }
      }
    },
